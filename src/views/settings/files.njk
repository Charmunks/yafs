{% extends "base.njk" %}

{% block content %}
<div class="settings-container">
  <div class="settings-header">
    <h1>File Management</h1>
    <a href="/settings" class="btn">Back to Settings</a>
  </div>
  
  {% if error %}
    <div class="error">{{ error }}</div>
  {% endif %}

  <section class="settings-section">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Filename</th>
          <th>Owner</th>
          <th>Visibility</th>
          <th>Created</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for file in files %}
        <tr>
          <td>
            <a href="/files/{{ file.id }}">{{ file.filename }}</a>
          </td>
          <td>{{ file.ownerUsername or 'Unknown' }}</td>
          <td>
            {% if file.is_public %}
              <span class="badge badge-public">Public</span>
            {% else %}
              <span class="badge">Private</span>
            {% endif %}
          </td>
          <td>{{ file.created_at | date }}</td>
          <td class="actions">
            <form method="POST" action="/settings/files/{{ file.id }}/toggle-public" class="inline-form">
              <button type="submit" class="btn btn-small">
                {% if file.is_public %}Make Private{% else %}Make Public{% endif %}
              </button>
            </form>
            <form method="POST" action="/settings/files/{{ file.id }}/delete" class="inline-form" onsubmit="return confirm('Delete file {{ file.filename }}?')">
              <button type="submit" class="btn btn-small btn-danger">Delete</button>
            </form>
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="5">No files found.</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
</div>
{% endblock %}
