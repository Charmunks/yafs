{% extends "base.njk" %}

{% block content %}
<div class="settings-container">
  <h1>Settings</h1>
  
  {% if error %}
    <div class="error">{{ error }}</div>
  {% endif %}

  <section class="settings-section">
    <h2>Registration</h2>
    <form method="POST" action="/settings/registration" class="settings-form">
      <label class="toggle-label">
        <input type="checkbox" name="enabled" {% if registrationEnabled %}checked{% endif %}>
        <span>Allow new account registration</span>
      </label>
      <button type="submit" class="btn">Save</button>
    </form>
  </section>

  <section class="settings-section">
    <h2>Markdown</h2>
    <form method="POST" action="/settings/markdown-sanitization" class="settings-form">
      <label class="toggle-label">
        <input type="checkbox" name="enabled" {% if markdownSanitizationEnabled %}checked{% endif %}>
        <span>Sanitize markdown preview (you probably want this on)</span>
      </label>
      <button type="submit" class="btn">Save</button>
    </form>
  </section>

  <section class="settings-section">
    <h2>File Storage</h2>
    <form method="POST" action="/settings/storage" class="settings-form">
      <div class="form-group">
        <label for="storagePath">Storage Path</label>
        <input type="text" id="storagePath" name="storagePath" value="{{ storagePath }}" class="form-control">
        <small>Directory where uploaded files will be stored</small>
      </div>
      <button type="submit" class="btn">Save</button>
    </form>
  </section>
</div>
{% endblock %}
