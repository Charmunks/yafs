{% extends "base.njk" %}

{% block content %}
<div class="settings-container">
  <h1>Settings</h1>
  
  {% if error %}
    <div class="error">{{ error }}</div>
  {% endif %}

  <section class="settings-section settings-nav">
    <h2>Administration</h2>
    <div class="settings-nav-links">
      <a href="/settings/users" class="btn">Manage Users</a>
      <a href="/settings/files" class="btn">Manage Files</a>
    </div>
  </section>

  <section class="settings-section">
    <h2>Site Title</h2>
    <form method="POST" action="/settings/site-title" class="settings-form">
      <div class="form-group">
        <input type="text" id="siteTitle" name="siteTitle" value="{{ pageTitleSetting }}" placeholder="YAFS" class="form-control">
        <small>Displayed in the header and page titles</small>
      </div>
      <button type="submit" class="btn">Save</button>
    </form>
  </section>

  <section class="settings-section">
    <h2>Registration</h2>
    <form method="POST" action="/settings/registration" class="settings-form-vertical">
      <div class="radio-group">
        <label class="radio-label">
          <input type="radio" name="registrationMode" value="open" {% if registrationMode == 'open' %}checked{% endif %}>
          <span>Fully open registration</span>
        </label>
        <label class="radio-label">
          <input type="radio" name="registrationMode" value="key" {% if registrationMode == 'key' %}checked{% endif %}>
          <span>Registration key required</span>
        </label>
        <label class="radio-label">
          <input type="radio" name="registrationMode" value="disabled" {% if registrationMode == 'disabled' or not registrationMode %}checked{% endif %}>
          <span>Registration disabled</span>
        </label>
      </div>
      
      <div class="form-group" id="registrationKeyGroup" style="width: 100%;">
        <label for="registrationKey">Registration Key</label>
        <input type="text" id="registrationKey" name="registrationKey" value="{{ registrationKey }}" placeholder="Enter a key users must provide to register">
      </div>
      
      <div class="form-group" id="registrationDisabledGroup" style="width: 100%; gap: 0.5rem;">
        <label for="registrationDisabledMessage">Disabled Message (optional)</label>
        <textarea id="registrationDisabledMessage" name="registrationDisabledMessage" rows="3" placeholder="Explain why registration is disabled" style="margin-top: 0.5rem;">{{ registrationDisabledMessage }}</textarea>
      </div>
      
      <button type="submit" class="btn">Save</button>
    </form>
    
    <script>
      (function() {
        const radios = document.querySelectorAll('input[name="registrationMode"]');
        const keyGroup = document.getElementById('registrationKeyGroup');
        const disabledGroup = document.getElementById('registrationDisabledGroup');
        
        function updateVisibility() {
          const selected = document.querySelector('input[name="registrationMode"]:checked').value;
          keyGroup.style.display = selected === 'key' ? 'block' : 'none';
          disabledGroup.style.display = selected === 'disabled' ? 'block' : 'none';
        }
        
        radios.forEach(radio => radio.addEventListener('change', updateVisibility));
        updateVisibility();
      })();
    </script>
  </section>

  <section class="settings-section">
    <h2>Markdown</h2>
    <form method="POST" action="/settings/markdown-sanitization" class="settings-form">
      <label class="toggle-label">
        <input type="checkbox" name="enabled" {% if markdownSanitizationEnabled %}checked{% endif %}>
        <span>Sanitize markdown file previews (you probably want this on)</span>
      </label>
      <button type="submit" class="btn">Save</button>
    </form>
  </section>

  <section class="settings-section">
    <h2>File Storage</h2>
    <form method="POST" action="/settings/storage" class="settings-form">
      <div class="form-group">
        <label for="storagePath">Storage Path</label>
        <input type="text" id="storagePath" name="storagePath" value="{{ storagePath }}" class="form-control">
        <small>Directory where uploaded files will be stored</small>
      </div>
      <button type="submit" class="btn">Save</button>
    </form>
  </section>

  <section class="settings-section">
    <h2>Footer</h2>
    <form method="POST" action="/settings/footer" class="settings-form">
      <label class="toggle-label">
        <input type="checkbox" name="enabled" {% if footerEnabled %}checked{% endif %}>
        <span>Show "Powered by YAFS" footer</span>
      </label>
      <button type="submit" class="btn">Save</button>
    </form>
  </section>
</div>
{% endblock %}
