{% extends "base.njk" %}
{% from "partials/icons.njk" import edit as editIcon, check %}
{% from "partials/forms.njk" import folderPicker, folderPickerScript, publicToggle, unlistedToggle, errorMessage %}

{% block content %}
<div class="upload-container">
  <div class="upload-card">
    <div class="upload-header">
      {{ editIcon(48) }}
      <h1>Edit File</h1>
    </div>

    {{ errorMessage(error) }}

    <form method="POST" action="/files/edit/{{ file.id }}" class="upload-form">
      <div class="form-group">
        <label for="filename">Filename</label>
        <input type="text" id="filename" name="filename" value="{{ file.filename }}" required>
      </div>

      <div class="form-group">
        <label for="description">Description (optional)</label>
        <textarea id="description" name="description" rows="3" placeholder="Add a description for this file">{{ file.description or '' }}</textarea>
      </div>

      {{ folderPicker(file.folder or '') }}
      {{ publicToggle(file.isPublic) }}
      {{ unlistedToggle(file.isUnlisted) }}

      <div class="upload-actions">
        <a href="/files/{{ file.id }}" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">
          {{ check(18) }}
          Save Changes
        </button>
      </div>
    </form>
  </div>
</div>

{{ folderPickerScript(file.folder or '') }}
{% endblock %}
