{% extends "base.njk" %}
{% from "partials/icons.njk" import upload as uploadIcon, check %}
{% from "partials/forms.njk" import dropzone, folderPicker, folderPickerScript, publicToggle, errorMessage %}

{% block content %}
<div class="upload-container">
  <div class="upload-card">
    <div class="upload-header">
      {{ uploadIcon(48) }}
      <h1>Upload File</h1>
    </div>

    {{ errorMessage(error) }}

    <form method="POST" action="/files/upload" enctype="multipart/form-data" class="upload-form">
      {{ dropzone() }}

      <div class="form-group single-file-only" id="customFilenameGroup">
        <label for="customFilename">Custom filename (optional)</label>
        <input type="text" id="customFilename" name="customFilename" placeholder="Leave blank to use original filename">
      </div>

      <div class="form-group single-file-only" id="descriptionGroup">
        <label for="description">Description (optional)</label>
        <textarea id="description" name="description" rows="3" placeholder="Add a description for this file"></textarea>
      </div>

      {{ folderPicker() }}
      {{ publicToggle() }}

      <div class="upload-progress" id="uploadProgress" style="display: none;">
        <div class="progress-info">
          <span id="progressText">Uploading...</span>
          <span id="progressCount">0 / 0</span>
        </div>
        <div class="progress-bar-container">
          <div class="progress-bar" id="progressBar"></div>
        </div>
        <div class="progress-current" id="progressCurrent"></div>
      </div>

      <div class="upload-actions" id="uploadActions">
        <a href="/" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary" id="submitBtn">
          {{ uploadIcon(18) }}
          Upload
        </button>
      </div>
    </form>
  </div>
</div>

{{ folderPickerScript() }}

<script>
  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('file');
  const fileName = document.getElementById('fileName');
  const singleFileFields = document.querySelectorAll('.single-file-only');
  const form = document.querySelector('.upload-form');
  const uploadProgress = document.getElementById('uploadProgress');
  const uploadActions = document.getElementById('uploadActions');
  const progressText = document.getElementById('progressText');
  const progressCount = document.getElementById('progressCount');
  const progressBar = document.getElementById('progressBar');
  const progressCurrent = document.getElementById('progressCurrent');
  const submitBtn = document.getElementById('submitBtn');

  function updateFileDisplay() {
    const count = fileInput.files.length;
    if (count > 1) {
      fileName.textContent = `${count} files selected`;
      dropzone.classList.add('has-file');
      singleFileFields.forEach(el => el.style.display = 'none');
    } else if (count === 1) {
      fileName.textContent = fileInput.files[0].name;
      dropzone.classList.add('has-file');
      singleFileFields.forEach(el => el.style.display = '');
    } else {
      fileName.textContent = '';
      dropzone.classList.remove('has-file');
      singleFileFields.forEach(el => el.style.display = '');
    }
  }

  fileInput.addEventListener('change', updateFileDisplay);

  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('dragover');
  });

  dropzone.addEventListener('dragleave', () => {
    dropzone.classList.remove('dragover');
  });

  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('dragover');
    if (e.dataTransfer.files.length > 0) {
      fileInput.files = e.dataTransfer.files;
      updateFileDisplay();
    }
  });

  document.addEventListener('paste', (e) => {
    const items = e.clipboardData?.items;
    if (!items) return;
    
    for (const item of items) {
      if (item.type.startsWith('image/')) {
        const file = item.getAsFile();
        if (file) {
          const dataTransfer = new DataTransfer();
          dataTransfer.items.add(file);
          fileInput.files = dataTransfer.files;
          updateFileDisplay();
          break;
        }
      }
    }
  });

  form.addEventListener('submit', async (e) => {
    const files = fileInput.files;
    if (files.length <= 1) return;

    e.preventDefault();

    const folder = document.getElementById('folder').value;
    const isPublic = document.querySelector('input[name="isPublic"]').checked;

    uploadProgress.style.display = 'block';
    uploadActions.style.display = 'none';
    dropzone.style.pointerEvents = 'none';
    dropzone.style.opacity = '0.6';

    const total = files.length;
    let uploaded = 0;
    let failed = 0;

    for (const file of files) {
      progressCurrent.textContent = `Uploading: ${file.name}`;
      progressCount.textContent = `${uploaded} / ${total}`;
      progressBar.style.width = `${(uploaded / total) * 100}%`;

      const formData = new FormData();
      formData.append('file', file);
      formData.append('folder', folder);
      formData.append('isPublic', isPublic ? 'true' : 'false');

      try {
        const response = await fetch('/files/upload/single', {
          method: 'POST',
          body: formData
        });

        if (response.ok) {
          uploaded++;
        } else {
          failed++;
        }
      } catch (err) {
        failed++;
      }

      progressCount.textContent = `${uploaded} / ${total}`;
      progressBar.style.width = `${(uploaded / total) * 100}%`;
    }

    progressText.textContent = 'Complete!';
    progressCurrent.textContent = failed > 0 ? `${failed} file(s) failed to upload` : 'All files uploaded successfully';
    progressBar.style.width = '100%';

    setTimeout(() => {
      window.location.href = '/';
    }, 1000);
  });
</script>
{% endblock %}
