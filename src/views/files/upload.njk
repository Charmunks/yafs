{% extends "base.njk" %}

{% block content %}
<div class="upload-container">
  <div class="upload-card">
    <div class="upload-header">
      <svg class="upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="17 8 12 3 7 8"/>
        <line x1="12" y1="3" x2="12" y2="15"/>
      </svg>
      <h1>Upload File</h1>
    </div>

    {% if error %}
      <div class="error">{{ error }}</div>
    {% endif %}

    <form method="POST" action="/files/upload" enctype="multipart/form-data" class="upload-form">
      <div class="dropzone" id="dropzone">
        <input type="file" id="file" name="files" multiple required>
        <div class="dropzone-content">
          <svg class="dropzone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 16V4m0 0L8 8m4-4l4 4"/>
            <path d="M3 15v4a2 2 0 002 2h14a2 2 0 002-2v-4"/>
          </svg>
          <span class="dropzone-text">Drag & drop your file(s) here</span>
          <span class="dropzone-hint">or click to browse</span>
        </div>
        <span class="file-name" id="fileName"></span>
      </div>

      <div class="form-group single-file-only" id="customFilenameGroup">
        <label for="customFilename">Custom filename (optional)</label>
        <input type="text" id="customFilename" name="customFilename" placeholder="Leave blank to use original filename">
      </div>

      <div class="form-group single-file-only" id="descriptionGroup">
        <label for="description">Description (optional)</label>
        <textarea id="description" name="description" rows="3" placeholder="Add a description for this file"></textarea>
      </div>

      <div class="form-group">
        <label for="folder">Folder (optional)</label>
        <div class="folder-picker">
          <select id="folderSelect" class="folder-select">
            <option value="">Root (no folder)</option>
          </select>
          <button type="button" id="newFolderBtn" class="btn btn-secondary btn-small">New Folder</button>
        </div>
        <input type="hidden" id="folder" name="folder" value="">
        <div id="newFolderInput" class="new-folder-input" style="display: none;">
          <input type="text" id="newFolderName" placeholder="Enter folder path (e.g., photos/vacation)">
          <button type="button" id="confirmNewFolder" class="btn btn-primary btn-small">Add</button>
          <button type="button" id="cancelNewFolder" class="btn btn-secondary btn-small">Cancel</button>
        </div>
      </div>

      <div class="form-group">
        <label class="toggle-label">
          <input type="checkbox" name="isPublic" value="true">
          <span class="toggle-text">Make file public</span>
        </label>
        <span class="form-hint">Public files can be viewed by anyone, even without signing in.</span>
      </div>

      <div class="upload-progress" id="uploadProgress" style="display: none;">
        <div class="progress-info">
          <span id="progressText">Uploading...</span>
          <span id="progressCount">0 / 0</span>
        </div>
        <div class="progress-bar-container">
          <div class="progress-bar" id="progressBar"></div>
        </div>
        <div class="progress-current" id="progressCurrent"></div>
      </div>

      <div class="upload-actions" id="uploadActions">
        <a href="/" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary" id="submitBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
          Upload
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('file');
  const fileName = document.getElementById('fileName');
  const singleFileFields = document.querySelectorAll('.single-file-only');
  const form = document.querySelector('.upload-form');
  const uploadProgress = document.getElementById('uploadProgress');
  const uploadActions = document.getElementById('uploadActions');
  const progressText = document.getElementById('progressText');
  const progressCount = document.getElementById('progressCount');
  const progressBar = document.getElementById('progressBar');
  const progressCurrent = document.getElementById('progressCurrent');
  const submitBtn = document.getElementById('submitBtn');

  const folderSelect = document.getElementById('folderSelect');
  const folderInput = document.getElementById('folder');
  const newFolderBtn = document.getElementById('newFolderBtn');
  const newFolderInput = document.getElementById('newFolderInput');
  const newFolderName = document.getElementById('newFolderName');
  const confirmNewFolder = document.getElementById('confirmNewFolder');
  const cancelNewFolder = document.getElementById('cancelNewFolder');

  async function loadFolders() {
    try {
      const response = await fetch('/api/folders');
      const data = await response.json();
      
      folderSelect.innerHTML = '<option value="">Root (no folder)</option>';
      for (const folder of data.folders) {
        const option = document.createElement('option');
        option.value = folder;
        option.textContent = folder;
        folderSelect.appendChild(option);
      }
    } catch (err) {
      console.error('Failed to load folders:', err);
    }
  }

  loadFolders();

  folderSelect.addEventListener('change', () => {
    folderInput.value = folderSelect.value;
  });

  newFolderBtn.addEventListener('click', () => {
    newFolderInput.style.display = 'flex';
    newFolderName.focus();
  });

  cancelNewFolder.addEventListener('click', () => {
    newFolderInput.style.display = 'none';
    newFolderName.value = '';
  });

  confirmNewFolder.addEventListener('click', () => {
    const folderPath = newFolderName.value.trim().replace(/^\/+|\/+$/g, '');
    if (folderPath) {
      const exists = Array.from(folderSelect.options).some(opt => opt.value === folderPath);
      if (!exists) {
        const option = document.createElement('option');
        option.value = folderPath;
        option.textContent = folderPath;
        folderSelect.appendChild(option);
      }
      folderSelect.value = folderPath;
      folderInput.value = folderPath;
    }
    newFolderInput.style.display = 'none';
    newFolderName.value = '';
  });

  newFolderName.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      confirmNewFolder.click();
    } else if (e.key === 'Escape') {
      cancelNewFolder.click();
    }
  });

  function updateFileDisplay() {
    const count = fileInput.files.length;
    if (count > 1) {
      fileName.textContent = `${count} files selected`;
      dropzone.classList.add('has-file');
      singleFileFields.forEach(el => el.style.display = 'none');
    } else if (count === 1) {
      fileName.textContent = fileInput.files[0].name;
      dropzone.classList.add('has-file');
      singleFileFields.forEach(el => el.style.display = '');
    } else {
      fileName.textContent = '';
      dropzone.classList.remove('has-file');
      singleFileFields.forEach(el => el.style.display = '');
    }
  }

  fileInput.addEventListener('change', updateFileDisplay);

  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('dragover');
  });

  dropzone.addEventListener('dragleave', () => {
    dropzone.classList.remove('dragover');
  });

  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('dragover');
    if (e.dataTransfer.files.length > 0) {
      fileInput.files = e.dataTransfer.files;
      updateFileDisplay();
    }
  });

  document.addEventListener('paste', (e) => {
    const items = e.clipboardData?.items;
    if (!items) return;
    
    for (const item of items) {
      if (item.type.startsWith('image/')) {
        const file = item.getAsFile();
        if (file) {
          const dataTransfer = new DataTransfer();
          dataTransfer.items.add(file);
          fileInput.files = dataTransfer.files;
          updateFileDisplay();
          break;
        }
      }
    }
  });

  form.addEventListener('submit', async (e) => {
    const files = fileInput.files;
    if (files.length <= 1) return;

    e.preventDefault();

    const folder = document.getElementById('folder').value;
    const isPublic = document.querySelector('input[name="isPublic"]').checked;

    uploadProgress.style.display = 'block';
    uploadActions.style.display = 'none';
    dropzone.style.pointerEvents = 'none';
    dropzone.style.opacity = '0.6';

    const total = files.length;
    let uploaded = 0;
    let failed = 0;

    for (const file of files) {
      progressCurrent.textContent = `Uploading: ${file.name}`;
      progressCount.textContent = `${uploaded} / ${total}`;
      progressBar.style.width = `${(uploaded / total) * 100}%`;

      const formData = new FormData();
      formData.append('file', file);
      formData.append('folder', folder);
      formData.append('isPublic', isPublic ? 'true' : 'false');

      try {
        const response = await fetch('/files/upload/single', {
          method: 'POST',
          body: formData
        });

        if (response.ok) {
          uploaded++;
        } else {
          failed++;
        }
      } catch (err) {
        failed++;
      }

      progressCount.textContent = `${uploaded} / ${total}`;
      progressBar.style.width = `${(uploaded / total) * 100}%`;
    }

    progressText.textContent = 'Complete!';
    progressCurrent.textContent = failed > 0 ? `${failed} file(s) failed to upload` : 'All files uploaded successfully';
    progressBar.style.width = '100%';

    setTimeout(() => {
      window.location.href = '/';
    }, 1000);
  });
</script>
{% endblock %}
