{% extends "base.njk" %}
{% from "partials/back-link.njk" import backLink %}
{% from "partials/back-link-folder.njk" import backLinkFolder %}
{% from "partials/file-detail-actions.njk" import fileDetailActions %}

{% block meta %}
<meta property="og:title" content="{{ file.filename }}">
<meta property="og:type" content="video.other">
<meta property="og:video" content="{{ baseUrl }}/files/view/{{ file.id }}">
<meta property="og:video:type" content="video/{{ ext }}">
<meta name="twitter:card" content="player">
<meta name="twitter:title" content="{{ file.filename }}">
<meta name="twitter:player" content="{{ baseUrl }}/files/preview/{{ file.id }}">
<meta name="twitter:player:stream" content="{{ baseUrl }}/files/view/{{ file.id }}">
<meta name="twitter:player:stream:content_type" content="video/{{ ext }}">
{% if file.description %}
<meta property="og:description" content="{{ file.description }}">
<meta name="twitter:description" content="{{ file.description }}">
{% endif %}
{% endblock %}

{% block content %}
<div class="file-detail-container">
  
{% if file.folder %}
  {{ backLinkFolder(file.folder) }}
{% else %}
  {{ backLink() }}
{% endif %}

  <div class="video-preview">
    <video controls>
      <source src="/files/view/{{ file.id }}" type="video/{{ ext }}">
      Your browser does not support the video tag.
    </video>
  </div>

  <div class="file-info">
    <h1 class="file-title">{{ file.filename }}</h1>
    {% if file.description %}
      <p class="file-description">{{ file.description }}</p>
    {% endif %}
  </div>

  {{ fileDetailActions(file, isOwner) }}
</div>
{% endblock %}
