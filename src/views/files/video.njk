{% extends "base.njk" %}
{% from "partials/back-link.njk" import backLink %}
{% from "partials/file-detail-actions.njk" import fileDetailActions %}

{% block content %}
<div class="file-detail-container">
  {{ backLink() }}

  <div class="video-preview">
    <video controls>
      <source src="/files/view/{{ file.id }}" type="video/{{ ext }}">
      Your browser does not support the video tag.
    </video>
  </div>

  <div class="file-info">
    <h1 class="file-title">{{ file.filename }}</h1>
    {% if file.description %}
      <p class="file-description">{{ file.description }}</p>
    {% endif %}
  </div>

  {{ fileDetailActions(file) }}
</div>
{% endblock %}
