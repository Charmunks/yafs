{# Empty State Component #}
{% from "partials/icons.njk" import folder as folderIcon %}

{% macro emptyState(message, showUploadLink=false) %}
<div class="empty-state">
  {{ folderIcon(64) }}
  <p>{{ message }}</p>
  {% if showUploadLink %}
    <a href="/files/upload" class="btn">Upload your first file</a>
  {% endif %}
</div>
{% endmacro %}
