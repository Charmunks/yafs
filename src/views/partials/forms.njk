{# Reusable Form Components #}

{% macro folderPicker(currentFolder="") %}
<div class="form-group">
  <label for="folder">Folder (optional)</label>
  <div class="folder-picker">
    <select id="folderSelect" class="folder-select">
      <option value="">Root (no folder)</option>
    </select>
    <button type="button" id="newFolderBtn" class="btn btn-secondary btn-small">New Folder</button>
  </div>
  <input type="hidden" id="folder" name="folder" value="{{ currentFolder }}">
  <div id="newFolderInput" class="new-folder-input" style="display: none;">
    <div class="new-folder-parent">
      <label for="parentFolderSelect">Create in:</label>
      <select id="parentFolderSelect" class="folder-select">
        <option value="">Root</option>
      </select>
    </div>
    <input type="text" id="newFolderName" placeholder="New folder name">
    <div class="new-folder-actions">
      <button type="button" id="confirmNewFolder" class="btn btn-primary btn-small">Add</button>
      <button type="button" id="cancelNewFolder" class="btn btn-secondary btn-small">Cancel</button>
    </div>
  </div>
</div>
{% endmacro %}

{% macro folderPickerScript(currentFolder="") %}
<script>
  (function() {
    const folderSelect = document.getElementById('folderSelect');
    const parentFolderSelect = document.getElementById('parentFolderSelect');
    const folderInput = document.getElementById('folder');
    const newFolderBtn = document.getElementById('newFolderBtn');
    const newFolderInput = document.getElementById('newFolderInput');
    const newFolderName = document.getElementById('newFolderName');
    const confirmNewFolder = document.getElementById('confirmNewFolder');
    const cancelNewFolder = document.getElementById('cancelNewFolder');
    const currentFolder = '{{ currentFolder }}';
    let allFolders = [];

    function renderFolderOptions(select, folders, selectedValue, includeRoot = true) {
      select.innerHTML = includeRoot ? '<option value="">Root (no folder)</option>' : '<option value="">Root</option>';
      for (const folder of folders) {
        const option = document.createElement('option');
        option.value = folder;
        const depth = (folder.match(/\//g) || []).length;
        option.textContent = '\u00A0\u00A0'.repeat(depth) + folder.split('/').pop();
        option.title = folder;
        if (folder === selectedValue) {
          option.selected = true;
        }
        select.appendChild(option);
      }
    }

    async function loadFolders() {
      try {
        const response = await fetch('/api/folders');
        const data = await response.json();
        allFolders = data.folders;
        
        renderFolderOptions(folderSelect, allFolders, currentFolder);
        renderFolderOptions(parentFolderSelect, allFolders, '', false);
        
        if (currentFolder && !allFolders.includes(currentFolder)) {
          const option = document.createElement('option');
          option.value = currentFolder;
          option.textContent = currentFolder;
          option.selected = true;
          folderSelect.appendChild(option);
        }
      } catch (err) {
        console.error('Failed to load folders:', err);
      }
    }

    loadFolders();

    folderSelect.addEventListener('change', () => {
      folderInput.value = folderSelect.value;
    });

    newFolderBtn.addEventListener('click', () => {
      newFolderInput.style.display = 'flex';
      renderFolderOptions(parentFolderSelect, allFolders, '', false);
      newFolderName.focus();
    });

    cancelNewFolder.addEventListener('click', () => {
      newFolderInput.style.display = 'none';
      newFolderName.value = '';
      parentFolderSelect.value = '';
    });

    confirmNewFolder.addEventListener('click', () => {
      const folderName = newFolderName.value.trim().replace(/[\/\\]/g, '');
      if (folderName) {
        const parentPath = parentFolderSelect.value;
        const fullPath = parentPath ? `${parentPath}/${folderName}` : folderName;
        
        if (!allFolders.includes(fullPath)) {
          allFolders.push(fullPath);
          allFolders.sort();
        }
        
        renderFolderOptions(folderSelect, allFolders, fullPath);
        folderSelect.value = fullPath;
        folderInput.value = fullPath;
      }
      newFolderInput.style.display = 'none';
      newFolderName.value = '';
      parentFolderSelect.value = '';
    });

    newFolderName.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        confirmNewFolder.click();
      } else if (e.key === 'Escape') {
        cancelNewFolder.click();
      }
    });
  })();
</script>
{% endmacro %}

{% macro dropzone() %}
{% from "partials/icons.njk" import uploadArrow %}
<div class="dropzone" id="dropzone">
  <input type="file" id="file" name="files" multiple>
  <div class="dropzone-content">
    {{ uploadArrow(40) }}
    <span class="dropzone-text">Drag & drop your file(s) here</span>
    <span class="dropzone-hint">or click to browse</span>
  </div>
  <span class="file-name" id="fileName"></span>
</div>
{% endmacro %}

{% macro publicToggle(checked=false) %}
<div class="form-group">
  <label class="toggle-label">
    <input type="checkbox" name="isPublic" value="true" {% if checked %}checked{% endif %}>
    <span class="toggle-text">Make file public</span>
  </label>
  <span class="form-hint">Public files can be viewed by anyone, even without signing in.</span>
</div>
{% endmacro %}

{% macro unlistedToggle(checked=false) %}
<div class="form-group">
  <label class="toggle-label">
    <input type="checkbox" name="isUnlisted" value="true" {% if checked %}checked{% endif %}>
    <span class="toggle-text">Make file unlisted</span>
  </label>
  <span class="form-hint">Unlisted files are accessible via direct link but don't appear in listings.</span>
</div>
{% endmacro %}

{% macro visibilitySwitcher(value="private") %}
<div class="form-group">
  <label>Visibility</label>
  <div class="visibility-switcher">
    <label class="visibility-option">
      <input type="radio" name="visibility" value="private" {% if value == "private" %}checked{% endif %}>
      <span class="visibility-label">Private</span>
    </label>
    <label class="visibility-option">
      <input type="radio" name="visibility" value="unlisted" {% if value == "unlisted" %}checked{% endif %}>
      <span class="visibility-label">Unlisted</span>
    </label>
    <label class="visibility-option">
      <input type="radio" name="visibility" value="public" {% if value == "public" %}checked{% endif %}>
      <span class="visibility-label">Public</span>
    </label>
  </div>
  <span class="form-hint visibility-hint" data-private="Private files are only visible to you." data-unlisted="Unlisted files are accessible via direct link but don't appear in listings." data-public="Public files can be viewed by anyone, even without signing in."></span>
</div>
<script>
  (function() {
    const radios = document.querySelectorAll('input[name="visibility"]');
    const hint = document.querySelector('.visibility-hint');
    function updateHint() {
      const checked = document.querySelector('input[name="visibility"]:checked');
      if (checked && hint) {
        hint.textContent = hint.dataset[checked.value];
      }
    }
    radios.forEach(r => r.addEventListener('change', updateHint));
    updateHint();
  })();
</script>
{% endmacro %}

{% macro errorMessage(error) %}
{% if error %}
  <div class="error">{{ error }}</div>
{% endif %}
{% endmacro %}
